{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "germanly.uxabhi.com"
        }
      ],
      "destination": "/germanly/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "oncarea.uxabhi.com"
        }
      ],
      "destination": "/oncarea/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "bnz.uxabhi.com"
        }
      ],
      "destination": "/bnz/$1"
    },
    {
      "source": "/",
      "destination": "/cases/"
    }
  ]
}
